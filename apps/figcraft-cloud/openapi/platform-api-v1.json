{
  "openapi": "3.1.0",
  "info": {
    "title": "FigCraft Cloud platform API",
    "version": "1.0.0",
    "description": "Operator API for the deployment: platform admins sign in (password then TOTP) and create, suspend, restore and archive workspaces, assign plans and read the platform audit log. A separate realm from /api/v1: it uses its own session cookie and cannot be reached with a workspace session or service-account credential. The platform sees workspace metadata only, never content. Every failure uses the fixed error envelope."
  },
  "servers": [
    {
      "url": "/platform/v1"
    }
  ],
  "security": [
    {
      "platformSession": []
    }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getPlatformOpenApi",
        "summary": "This document.",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/bootstrap": {
      "post": {
        "operationId": "bootstrapPlatform",
        "summary": "Create the first platform admin with the one-time token printed by the CLI.",
        "description": "Valid once, for a short time. 403 when the token is wrong, spent or expired, or an admin already exists. The password must meet the same policy as workspace accounts.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Bootstrap"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminEnvelope"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/session": {
      "post": {
        "operationId": "signIn",
        "summary": "Check the password and open a session that still needs the second factor.",
        "description": "Sets the cookie __Secure-figcraft-platform (Path=/platform/v1, HttpOnly, Secure, SameSite=Strict). Every refusal is the same 401; five consecutive failures lock the admin for 15 minutes.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password accepted; `next` says whether to enrol or verify a TOTP code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "operationId": "getSession",
        "summary": "Who am I and which step is next.",
        "description": "Works with a session that has not passed the second factor yet.",
        "responses": {
          "200": {
            "description": "The session state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "signOut",
        "summary": "End the session.",
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/session/totp/enrol": {
      "post": {
        "operationId": "enrolTotp",
        "summary": "Create the TOTP secret (before it is confirmed).",
        "description": "Returns the base32 secret and an otpauth URI once. Allowed only while the second factor is not done and no code was ever confirmed.",
        "responses": {
          "200": {
            "description": "The secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrolment"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/session/totp": {
      "post": {
        "operationId": "verifyTotp",
        "summary": "Verify a six-digit code; the first verified code confirms the enrolment.",
        "description": "A step is accepted once. Failures count toward the lock.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpCode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Second factor done.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "second_factor_done": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/admins": {
      "get": {
        "operationId": "listAdmins",
        "summary": "List platform admins.",
        "responses": {
          "200": {
            "description": "Admins.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminList"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createAdmin",
        "summary": "Create a platform admin.",
        "description": "The new admin enrols a second factor at first sign-in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdmin"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admin"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/admins/{id}/disable": {
      "post": {
        "operationId": "disableAdmin",
        "summary": "Disable an admin and end their sessions.",
        "description": "Refused (403) for yourself and for the last active admin.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "The admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admin"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/admins/{id}/enable": {
      "post": {
        "operationId": "enableAdmin",
        "summary": "Enable an admin.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "The admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admin"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "summary": "List workspaces (metadata only).",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/WorkspaceState"
            }
          },
          {
            "name": "slug_prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspacePage"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createWorkspace",
        "summary": "Create a workspace.",
        "description": "With owner.principal_id the workspace is active at once. With owner.email it is pending and the response carries an owner_invitation whose token is shown once; the owner accepts it from the workspace app.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspace"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}": {
      "get": {
        "operationId": "getWorkspace",
        "summary": "One workspace's metadata.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}/suspend": {
      "post": {
        "operationId": "suspendWorkspace",
        "summary": "Suspend a workspace.",
        "description": "Members, sessions, relay rooms, share links, host and embed tokens and webhooks stop; nothing is deleted. Send {} or {\"reason\":\"...\"}.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reason"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}/restore": {
      "post": {
        "operationId": "restoreWorkspace",
        "summary": "Restore a suspended or archived workspace to active.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}/archive": {
      "post": {
        "operationId": "archiveWorkspace",
        "summary": "Archive a workspace (reversible).",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reason"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}/request-deletion": {
      "post": {
        "operationId": "requestWorkspaceDeletion",
        "summary": "Move an archived or suspended workspace to pending deletion.",
        "description": "Nothing is removed by this call.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reason"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}/cancel-deletion": {
      "post": {
        "operationId": "cancelWorkspaceDeletion",
        "summary": "Return a workspace in pending deletion to archived.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}/plan": {
      "put": {
        "operationId": "setWorkspacePlan",
        "summary": "Assign a plan.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Plan"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{id}/owner-invitation": {
      "post": {
        "operationId": "reissueOwnerInvitation",
        "summary": "Replace the owner link of a pending workspace.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReissueOwnerInvitation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new invitation (token shown once).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerInvitation"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/audit": {
      "get": {
        "operationId": "listPlatformAudit",
        "summary": "The platform audit log, newest first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "action_prefix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "platformSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-figcraft-platform",
        "description": "Set by POST /session; a session counts for most routes only after the second factor."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Failure in the fixed envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "WorkspaceState": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "suspended",
          "archived",
          "deleting",
          "deleted"
        ]
      },
      "Admin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "has_password": {
            "type": "boolean"
          },
          "totp_enrolled": {
            "type": "boolean"
          },
          "created_at": {
            "type": "integer"
          },
          "last_login_at": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "AdminEnvelope": {
        "type": "object",
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/Admin"
          }
        },
        "additionalProperties": false
      },
      "AdminList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Admin"
            }
          }
        },
        "additionalProperties": false
      },
      "Bootstrap": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "token",
          "login",
          "display_name",
          "password"
        ]
      },
      "SignIn": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "login",
          "password"
        ]
      },
      "SessionState": {
        "type": "object",
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/Admin"
          },
          "second_factor_done": {
            "type": "boolean"
          },
          "next": {
            "type": "string",
            "enum": [
              "totp_enrol",
              "totp",
              "none"
            ]
          }
        },
        "additionalProperties": false
      },
      "TotpCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      },
      "TotpEnrolment": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string"
          },
          "otpauth_uri": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateAdmin": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "login",
          "display_name",
          "password"
        ]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/WorkspaceState"
          },
          "plan_id": {
            "type": "string"
          },
          "home_region": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          },
          "active_members": {
            "type": "integer"
          },
          "owner_invitation": {
            "$ref": "#/components/schemas/OwnerInvitation"
          }
        },
        "additionalProperties": false
      },
      "WorkspacePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "OwnerInvitation": {
