{
  "openapi": "3.1.0",
  "info": {
    "title": "FigCraft Cloud accounts, history and versions API",
    "version": "1.0.0",
    "description": "Built-in accounts beside OIDC, attribution and document history. Browser calls use the session cookie and must be same-origin (Origin or Sec-Fetch-Site). Errors use the common envelope {error:{code,message,request_id}}; a refused password adds error.reason='password_policy' and an actionable message."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/methods": {
      "get": {
        "operationId": "getSignInMethods",
        "summary": "Sign-in methods the workspace offers",
        "responses": {
          "200": {
            "description": "Sign-in methods the workspace offers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "password": {
                      "type": "boolean"
                    },
                    "oidc": {
                      "type": "boolean"
                    },
                    "open_registration": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "tenant_id",
                    "password",
                    "oidc",
                    "open_registration"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "x-auth": "none",
        "parameters": [
          {
            "name": "tenant",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/password/signup": {
      "post": {
        "operationId": "passwordSignUp",
        "summary": "Create a password account from an invitation, or by open registration; signs the person in",
        "responses": {
          "201": {
            "description": "Create a password account from an invitation, or by open registration; signs the person in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "principal_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "tenant_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "principal_id",
                    "tenant_id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "x-auth": "none",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "invitation": {
                    "type": "string"
                  },
                  "tenant": {
                    "type": "string"
                  },
                  "login": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "display_name",
                  "password"
                ]
              }
            }
          }
        }
      }
    },
    "/auth/password/bootstrap": {
      "post": {
        "operationId": "passwordBootstrap",
        "summary": "Complete first-run setup of a single-tenant deployment with a password owner account; signs the owner in",
        "responses": {
          "200": {
            "description": "Complete first-run setup of a single-tenant deployment with a password owner account; signs the owner in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "principal_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "role": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "tenant_id",
                    "principal_id",
                    "role"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "x-auth": "none",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "login": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "token",
                  "login",
                  "display_name",
                  "password"
                ]
              }
            }
          }
        }
      }
    },
    "/tenants/{tenant}/account-settings": {
      "get": {
        "operationId": "getAccountSettings",
        "summary": "The workspace's account settings",
        "responses": {
          "200": {
            "description": "The workspace's account settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSettings"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "x-required-permission": "tenant.view",
        "x-auth": "tenant.view",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "put": {
        "operationId": "putAccountSettings",
        "summary": "Replace the workspace's account settings (at least one method on; open registration needs passwords)",
        "responses": {
          "200": {
            "description": "Replace the workspace's account settings (at least one method on; open registration needs passwords)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSettings"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "x-required-permission": "tenant.update_policy",
        "x-auth": "tenant.update_policy",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountSettings"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "AccountSettings": {
        "type": "object",
        "properties": {
          "password_enabled": {
            "type": "boolean"
          },
          "oidc_enabled": {
            "type": "boolean"
          },
          "open_registration": {
            "type": "boolean"
          },
          "require_totp": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "password_enabled",
          "oidc_enabled",
          "open_registration",
          "require_totp"
        ]
      }
    },
    "responses": {},
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-figcraft_session"
      }
    }
  }
}
