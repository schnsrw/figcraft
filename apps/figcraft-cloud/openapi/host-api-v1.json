  "webhooks": {
    "event": {
      "post": {
        "operationId": "receiveWebhookEvent",
        "summary": "What an endpoint receives.",
        "description": "Headers: X-FigCraft-Event-Id, X-FigCraft-Event-Type, X-FigCraft-Delivery-Id, X-FigCraft-Timestamp (Unix seconds) and X-FigCraft-Signature (v1=hex HMAC-SHA256 over timestamp + '.' + raw body, one item per live secret; reject timestamps more than 300 seconds from your clock). Any 2xx acknowledges; anything else is retried after 10 s, 30 s, 2 min, 10 min, 30 min, 2 h, 6 h, then the delivery fails until replayed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged."
          }
        }
      }
    }
  }
