{
  "openapi": "3.1.0",
  "info": {
    "title": "FigCraft Cloud host API",
    "version": "1.0.0",
    "description": "Server-to-server API for a registered host product that embeds FigCraft: create, resolve, archive and restore documents by the host's own identifiers and request exports. Versioned by the /api/v1 prefix; additive changes keep 1.x, a breaking change would be /api/v2. Every failure uses the fixed error envelope; messages never contain request data. Webhook deliveries are signed: see the X-FigCraft-Signature scheme in the delivery module documentation (HMAC-SHA256 over timestamp.body, v1= items, 300 second replay window)."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "serviceAccount": []
    }
  ],
  "paths": {
    "/host/openapi.json": {
      "get": {
        "operationId": "getHostOpenApi",
        "summary": "This document.",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/host/systems/{system_id}/documents": {
      "post": {
        "operationId": "createHostDocument",
        "summary": "Create a document inside a mapped project and map the host's external id onto it.",
        "description": "Requires scope documents:write and an Idempotency-Key header. Repeating the request with the same key and body replays the first response (same status, header Idempotent-Replay: true); the same key with a different body, or while the first attempt is still running, is 409 conflict. An external_id that is already mapped is 409 conflict.",
        "x-required-scope": "documents:write",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDocument"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/documents/{external_id}": {
      "get": {
        "operationId": "resolveHostDocument",
        "summary": "Resolve the host's external document id.",
        "x-required-scope": "documents:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "$ref": "#/components/parameters/ExternalId"
          }
        ],
        "responses": {
          "200": {
            "description": "The document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/documents/{external_id}/archive": {
      "post": {
        "operationId": "archiveHostDocument",
        "summary": "Archive the document. Idempotent: archiving an archived document succeeds unchanged.",
        "x-required-scope": "documents:write",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "$ref": "#/components/parameters/ExternalId"
          }
        ],
        "responses": {
          "200": {
            "description": "The document, now archived.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/documents/{external_id}/restore": {
      "post": {
        "operationId": "restoreHostDocument",
        "summary": "Restore an archived document. Idempotent: restoring an active document succeeds unchanged.",
        "x-required-scope": "documents:write",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "$ref": "#/components/parameters/ExternalId"
          }
        ],
        "responses": {
          "200": {
            "description": "The document, now active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/documents/{external_id}/exports": {
      "post": {
        "operationId": "requestHostExport",
        "summary": "Request an export job for the document on behalf of a mapped host user.",
        "description": "Requires scope exports:create and an Idempotency-Key header (replays return the first response with Idempotent-Replay: true). The job runs asynchronously; poll the export with getHostExport.",
        "x-required-scope": "exports:create",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "$ref": "#/components/parameters/ExternalId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestExport"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted (or replayed).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/exports/{export_id}": {
      "get": {
        "operationId": "getHostExport",
        "summary": "The state of an export job requested through this host.",
        "x-required-scope": "jobs:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "export_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The export.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/embed/exchange": {
      "post": {
        "operationId": "exchangeEmbedToken",
        "summary": "Exchange a host-issued one-use embed token for a browser session on the document it names.",
        "description": "Called by the embedded editor page (same origin), never by the host page. The token is an EdDSA or ES256 compact JWS signed with a key registered for the host, valid for at most 300 seconds and usable once. Every refusal is the same 401. The reported role is the lowest of the token's role, the host's registered maximum and the principal's own role on the document. Rate limited per client address and per issuer.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeEmbedToken"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A session cookie is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedSession"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/webhooks": {
      "get": {
        "operationId": "listHostWebhooks",
        "summary": "List the host's webhook endpoints (never their secrets).",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoints.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createHostWebhook",
        "summary": "Register an endpoint. The signing secret is in this response only.",
        "description": "The URL must be https with a public destination (loopback, private, link-local and internal names are refused). event_types empty means every event. At most 10 endpoints per host. The secret is stored encrypted and cannot be read back; rotate it to get a new one.",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhook"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookWithSecret"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/webhooks/{webhook_id}": {
      "get": {
        "operationId": "getHostWebhook",
        "summary": "One endpoint.",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Webhook"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "operationId": "updateHostWebhook",
        "summary": "Change the URL, the subscription or the enabled flag.",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWebhook"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Webhook"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteHostWebhook",
        "summary": "Delete the endpoint and its delivery history.",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/webhooks/{webhook_id}/rotate-secret": {
      "post": {
        "operationId": "rotateHostWebhookSecret",
        "summary": "Issue a new signing secret. The previous one keeps signing for 24 hours.",
        "description": "The new secret is in this response only. During the overlap each delivery carries a signature for both secrets, so a receiver can switch at its own pace.",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint with its new secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookWithSecret"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/webhooks/{webhook_id}/deliveries": {
      "get": {
        "operationId": "listHostWebhookDeliveries",
        "summary": "Recent deliveries to the endpoint, newest first (at most 50).",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "pending",
                "succeeded",
                "failed"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The deliveries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookDeliveryList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/webhooks/{webhook_id}/deliveries/{delivery_id}": {
      "get": {
        "operationId": "getHostWebhookDelivery",
        "summary": "One delivery with its attempt log (status and timing of the last 20 attempts; never bodies).",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookDeliveryDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/host/systems/{system_id}/webhooks/{webhook_id}/deliveries/{delivery_id}/replay": {
      "post": {
        "operationId": "replayHostWebhookDelivery",
        "summary": "Send a finished delivery again: same event, same body, same event id, a fresh attempt budget.",
        "description": "Only a succeeded or failed delivery can be replayed; a pending one is 409. Receivers deduplicate on the event id (delivery is at least once).",
        "x-required-scope": "webhooks:manage",
        "parameters": [
          {
            "$ref": "#/components/parameters/SystemId"
          },
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Queued again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookDelivery"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceAccount": {
        "type": "http",
        "scheme": "bearer",
        "description": "A tenant service-account credential with the scope named by x-required-scope."
      }
    },
    "parameters": {
      "SystemId": {
        "name": "system_id",
        "in": "path",
        "required": true,
        "description": "The registered host system id.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "ExternalId": {
        "name": "external_id",
        "in": "path",
        "required": true,
        "description": "The host's own identifier, as mapped.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "Error": {
        "description": "The fixed error envelope; the message depends only on the code.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "enum": [
                  "invalid_request",
                  "unauthenticated",
                  "forbidden",
                  "not_found",
                  "conflict",
                  "precondition_failed",
                  "resource_inactive",
                  "quota_exceeded",
                  "rate_limited",
                  "temporarily_unavailable",
                  "internal",
                  "invalid_cursor"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreateDocument": {
        "type": "object",
        "required": [
          "external_id",
          "external_project_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "external_project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "The host's id of a mapped project."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "id",
          "external_id",
          "workspace_id",
          "project_id",
          "name",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "external_id": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "active",
              "archived"
            ]
          }
        }
      },
      "RequestExport": {
        "type": "object",
        "required": [
          "format",
          "external_user_id"
        ],
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "png",
              "jpeg",
              "webp",
