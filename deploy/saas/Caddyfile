:8080 {
	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy cloud:8081
	}

	@realtime path /ws/v1 /ws/v1/*
	handle @realtime {
		reverse_proxy cloud:8081
	}

	# The browser editor (static, from the web image). `/edit/#join=<invite link>` joins a
	# cloud document through the collaboration relay.
	redir /edit /edit/ 308
	handle /edit/* {
		reverse_proxy web:8080
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:8080
	}
}
