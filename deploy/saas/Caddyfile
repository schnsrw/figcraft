:8080 {
	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy cloud:8081
	}

	# Core slice: the collaboration relay (FigCraft's collaboration protocol over WebSocket). The
	# path is kept: the relay answers on any path and invite links name /ws/v1/collab.
	@collab path /ws/v1/collab /ws/v1/collab/*
	handle @collab {
		reverse_proxy cloud:8082
	}

	@realtime path /ws/v1 /ws/v1/*
	handle @realtime {
		reverse_proxy cloud:8081
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:8080
	}
}
