# FigCraft SaaS Compose configuration template.
#
# Copy this file to `.env` only for local development. The values below are deliberately
# non-production: loopback URLs, reserved `.invalid` hostnames and paths to secrets that do not
# exist in the repository. Never put secret values in this file or commit `deploy/saas/.env`.

# Compose image inputs. PostgreSQL and Redis are pinned to reviewed multi-platform digests; see
# docs/saas/dependency-images.md. Caddy remains a local-development tag. Object storage remains
# intentionally unset: archived MinIO images are not an acceptable supported release policy.
# Do not use `latest` as a production policy.
CADDY_IMAGE=caddy:2.10.2-alpine
POSTGRES_IMAGE=postgres:18.6-bookworm@sha256:afc7e2d441324c0388fa80c3d24f733b4194a4eb7f47dd8ee2b08eb1a24a647c
POSTGRES_DATA_DIR=/var/lib/postgresql
REDIS_IMAGE=redis:7.2.16-bookworm@sha256:46f15cf64fdef63e483dcda99e74e3d51c017b1175547b6bb874152ee2391aad
# MINIO_IMAGE=<supported, reviewed S3-compatible image reference>
# MINIO_MC_IMAGE=<compatible, reviewed bucket-initializer image reference>

# Application mode. The initial single-node stack runs every cloud role in one process.
FIGCRAFT_ENV=development
FIGCRAFT_DEPLOYMENT=single
FIGCRAFT_ROLE=all
FIGCRAFT_PUBLIC_URL=http://127.0.0.1:8080
FIGCRAFT_SINGLE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Durable metadata and ordered collaboration events.
# The mounted file contains the full PostgreSQL connection URL, including its generated password.
DATABASE_URL_FILE=/run/secrets/database_url

# Replaceable routing, presence, leases, cache and rate-limit state.
# The mounted file contains the Redis URL and any generated password.
REDIS_URL_FILE=/run/secrets/redis_url

# Local S3-compatible object storage. Access credentials are mounted files, never environment
# values. The endpoint is private to the future Compose network.
S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_BUCKET=figcraft
S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
S3_FORCE_PATH_STYLE=true

# Reserved-host identity placeholders. Configure a real HTTPS issuer before exposing the service.
OIDC_ISSUER=https://identity.invalid
OIDC_CLIENT_ID=figcraft-local
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
OIDC_AUDIENCE=figcraft-local

# Authentication and embedding configuration.
SESSION_SIGNING_KEY_FILE=/run/secrets/session_signing_key
EMBED_ISSUER_CONFIG_FILE=/etc/figcraft/embed-issuers.toml

# Safe diagnostics. Enable OTLP only when the observability profile is configured.
RUST_LOG=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
