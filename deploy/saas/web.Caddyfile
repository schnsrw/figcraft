:8080 {
	encode zstd gzip

	# Runtime branding (docs/saas/branding-and-configuration.md): rendered per request from the
	# container's FIGCRAFT_BRAND_* environment, so a restart of this container rebrands the shell
	# and the editor without a rebuild. The template JSON-escapes every value; clients validate.
	handle /branding.json {
		root * /etc/caddy/branding
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		header -ETag
		header -Last-Modified
		templates {
			mime application/json
		}
		file_server
	}

	# Deployer-supplied brand assets (optional read-only bind mount at /srv/brand). Never falls
	# back to index.html; scripts inside an SVG opened directly are sandboxed.
	handle /brand/* {
		root * /srv
		header Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
		file_server
	}

	# The FigCraft editor (wasm32). `/edit/#join=<invite link>` joins a cloud document; the
	# fragment never reaches the server. No SPA fallback here: a missing asset is a 404, never
	# index.html served as `.wasm`.
	redir /edit /edit/ 308
	handle /edit/* {
		root * /srv
		@shell path /edit/ /edit/index.html
		header @shell Cache-Control "no-cache"
		@hashed path_regexp \.(wasm|js)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	# FigCraft Cloud: a file's page is the editor itself (WASM, full page; no iframe). It reads the
	# file's ids from the path and asks the API for it; the file browser links here.
	@cloudfile path_regexp cloudfile ^/workspace/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/file/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/edit)?/?$
	handle @cloudfile {
		root * /srv
		rewrite * /edit/index.html
		header Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
